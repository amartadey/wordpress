# Keep LF in files that run on Linux / are parsed by tools, regardless of OS.
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

*.png binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary
*.otf binary
